FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY turbo.json ./
RUN npm install
COPY apps/api/package*.json ./apps/api/

# Removed installation for apps/api to avoid duplicate @prisma/client

COPY prisma ./prisma
COPY apps/api ./apps/api

RUN npx prisma generate
# Removed prisma generate for API to avoid duplicate client
# Removed copy step for Prisma client

EXPOSE 3001

CMD ["npm", "run", "--prefix", "apps/api", "dev"]
