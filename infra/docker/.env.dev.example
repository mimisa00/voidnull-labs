# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://voidnull:secret@localhost:5432/voidnull_dev?schema=public"
POSTGRES_USER=voidnull
POSTGRES_PASSWORD=secret
POSTGRES_DB=voidnull_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_2FA_SECRET=change_me_2fa_secret_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ── CI/CD ─────────────────────────────────────────────────────────────────────
# Required for staging/prod image pulls from GitHub Container Registry
# Format: org/repo  e.g. voidnull-labs/voidnull
GITHUB_REPO=your-org/your-repo

# ── Domains (staging/prod only) ───────────────────────────────────────────────
# DOMAIN_MAIN=voidnull.io
# DOMAIN_ALT=voidnull.ai
# CERTBOT_EMAIL=admin@voidnull.io
