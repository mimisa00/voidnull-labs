# Production environment — copy to .env.prod and fill in secrets
# Usage: docker compose -f compose.prod.yml --env-file .env.prod up -d

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=voidnull_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=voidnull_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── JWT (must be at least 32 random chars each) ───────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_2FA_SECRET=CHANGE_ME_min_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
