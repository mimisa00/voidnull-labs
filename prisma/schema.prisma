generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  username            String    @unique
  password            String
  displayName         String?
  isActive            Boolean   @default(true)
  is2faEnabled        Boolean   @default(false)
  twoFASecret         String?
  userRoles           UserRole[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  refreshTokens       RefreshToken[]
  playerGames         PlayerGame[]
  gameHistories       GameHistory[]
  agentPerformances   AgentPerformance[]
  wallet              Wallet?
  tournamentParticipants TournamentParticipant[] @relation("UserTournamentParticipants")
  tournamentResults   TournamentResult[] @relation("UserTournamentResults")
}

model Role {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  resource    String
  action      String
  rolePermissions RolePermission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  role         Role     @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Game {
  id           String   @id @default(cuid())
  type         String
  status       String
  maxPlayers   Int
  buyIn        Int
  pot          Int
  bankroll     Int      @default(0) // 桌內籌碼池;與 pot(單局 pot)語意分離,純加性
  players      PlayerGame[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gameHistory  GameHistory[]
  transactions Transaction[]
}

model PlayerGame {
  id         String   @id @default(cuid())
  playerId   String
  gameId     String
  balance    Int
  hand       Json
  status     String
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  game       Game     @relation(fields: [gameId], references: [id])
  user       User     @relation(fields: [playerId], references: [id])
}

model GameHistory {
  id         String   @id @default(cuid())
  gameId     String
  winnerId   String?
  payout     Int
  timestamp  DateTime @default(now())
  
  game       Game     @relation(fields: [gameId], references: [id])
  winner     User?    @relation(fields: [winnerId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CageAsset {
  id        String    @id @default(cuid())
  branchId  String?
  assetType String
  amount    Decimal   @db.Decimal(18, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId])
}

model ApprovalLog {
  id         String    @id @default(cuid())
  targetType String
  targetId   String
  action     String
  actedBy    String?
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([targetType, action])
  @@index([createdAt])
}

model AgentPerformance {
  id               String    @id @default(cuid())
  agentId          String
  agent            User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commissionEarned Decimal   @db.Decimal(18, 2)
  customerCount    Int       @default(0)
  period           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([agentId, period])
  @@index([period])
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @db.Decimal(18, 2)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  walletId      String
  type          String
  amount        Decimal  @db.Decimal(18, 2)
  balanceBefore Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal  @db.Decimal(18, 2)
  gameId        String?
  description   String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  game          Game?    @relation(fields: [gameId], references: [id])
  @@index([walletId])
  @@index([gameId])
  @@index([createdAt])
}

model Tournament {
  id           String   @id @default(cuid())
  name         String
  status       String
  startTime    DateTime
  endTime      DateTime
  maxPlayers   Int
  entryFee     Int
  prizePool    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  participants TournamentParticipant[]
  results      TournamentResult[]
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  entryTime    DateTime   @default(now())
  status       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation("UserTournamentParticipants", fields: [userId], references: [id])
  @@unique([tournamentId, userId])
}

model TournamentResult {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  rank         Int
  finalBalance Decimal    @db.Decimal(18, 2)
  prize        Decimal    @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation("UserTournamentResults", fields: [userId], references: [id])
}
